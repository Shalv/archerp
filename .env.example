# Google Gemini API Key (server-side only)
GEMINI_API_KEY=

# Optional Gemini Model overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Server session encryption secret (minimum 32 characters)
SESSION_SECRET=

# Optional PostgreSQL database connection string (when connecting external DB)
DATABASE_URL=
